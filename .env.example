# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ahmadalbasha.com

# Cal.com booking link: "<username>/<event-slug>" (e.g. "ahmad-albasha/discovery-call")
NEXT_PUBLIC_CAL_LINK=ahmad-albasha/discovery-call

# Contact form delivery (optional). Without RESEND_API_KEY, submissions are logged on the server.
RESEND_API_KEY=
CONTACT_TO_EMAIL=ahmad-albasha09@hotmail.com
CONTACT_FROM_EMAIL=Portfolio <noreply@ahmadalbasha.com>
